<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Launch-window theme only. All in-app theming (dynamic color, light/dark,
      system bar contrast) is owned by MusicPlayerTheme in Compose, so this
      deliberately avoids the Material Components library and uses platform
      themes instead. The night variant lives in values-night/themes.xml.
    -->
    <style name="Theme.MusicPlayer" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>
</resources>
